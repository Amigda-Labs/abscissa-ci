# Abscissa CI local environment template.
#
# Copy this file to `.env` and fill in local values:
# cp .env.example .env

# Environment label for humans, logs, and future eval grouping.
ABSCISSA_ENV=production

# Dedicated OpenAI key for the tile/floor-plan extraction agent.
# The OpenAI dashboard secret key can be named development-tile-engineer,
# but the environment variable should use underscores.
ABSCISSA_TILE_ENGINEER_API_KEY=

# Optional fallback used by generic OpenAI tooling.
# The tile agent prefers ABSCISSA_TILE_ENGINEER_API_KEY when both are set.
OPENAI_API_KEY=

# Optional model override for the tile extraction agent.
# Use a vision-capable Responses/Agents model for image analysis.
ABSCISSA_MODEL=gpt-5.2

# Image detail for floor plan dimension extraction: low, high, or auto.
ABSCISSA_IMAGE_DETAIL=high
