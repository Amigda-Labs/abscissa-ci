# Abscissa CI local environment template.
#
# Copy this file to `.env` and fill in local values:
# cp .env.example .env

# Environment label for humans, logs, and future eval grouping.
ABSCISSA_ENV=local

# Shared OpenAI API key fallback.
OPENAI_API_KEY=

# CAD assistant. Prefer this when you want CAD agent usage separated from other agents.
ABSCISSA_CAD_AGENT_API_KEY=
ABSCISSA_CAD_AGENT_MODEL=gpt-5.5

# Area/image agent overrides.
ABSCISSA_AREA_AGENT_API_KEY=
ABSCISSA_AREA_MODEL=gpt-5.5
ABSCISSA_IMAGE_DETAIL=high
